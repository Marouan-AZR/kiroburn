{
  "name": "kiroburn",
  "version": "1.0.1",
  "description": "See where your Kiro CLI tokens go. TUI dashboard for token & cost tracking.",
  "type": "module",
  "bin": {
    "kiroburn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "menubar",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kiro",
    "kiro-cli",
    "token-usage",
    "cost-tracking",
    "tui",
    "dashboard",
    "ai-coding"
  ],
  "author": "Marouane Azrour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marouanazrour/kiroburn"
  },
  "homepage": "https://github.com/marouanazrour/kiroburn#readme",
  "dependencies": {
    "commander": "12.1.0",
    "ink": "5.1.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  }
}
